{
  "expo": {
    "name": "My Success",
    "slug": "account-ui-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.successprabu.aimobileapp"
    },
    "android": {
      "label": "My Success",
      "package": "com.successprabu.aimobileapp",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-speech-recognition",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to import receipts and to add photos of your hall.",
          "cameraPermission": "Allow the camera to add photos of homework, receipts and your hall."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow My Success to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#059669"
        }
      ]
    ],
    "scheme": "mysuccess"
  }
}
